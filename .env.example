# ---- PipsFarmer server settings. Copy to .env and fill in. ----
PF_SITE_NAME=PipsFarmer
PF_BASE_URL=https://app.yourdomain.com
# run: python tools/make_keys.py
PF_SECRET_KEY=
PF_FERNET_KEY=
PF_HOST=127.0.0.1
PF_PORT=8000
# set to 1 once the site is behind https (Cloudflare tunnel)
PF_HTTPS_ONLY=1

# ---- Telegram reader (the account inside your PipsFarmer VIP group) ----
# run: python tools/telegram_login.py
TG_API_ID=
TG_API_HASH=
TG_MAIN_SESSION=
TG_VIP_CHATS=

# ---- Telegram admin bot (renewal questions + VPS alerts) ----
# make a bot with @BotFather, then send it /start from both your phones to get your chat ids
TG_BOT_TOKEN=
TG_ADMIN_CHAT_IDS=
